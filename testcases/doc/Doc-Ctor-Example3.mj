// PDF §3 Example 3 — implicit super() across a three-level chain
class A {
    int x = 1;
}
class B extends A {
    int y = 2;
}
class C extends B {
    int z = 3;
    C() { }
}
int main() {
    C c = new C();
    println(c.x);   // 1
    println(c.y);   // 2
    println(c.z);   // 3
    return 0;
}
