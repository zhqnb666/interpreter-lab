// arr[idx].field 和 arr[idx].method() 基础场景 —— 元素声明类型 == 真实类型
class Node {
    int value;
    Node next;
    int getValue() { return value; }
    void bump() { value = value + 1; }
}
int main() {
    Node[] arr = new Node[3];
    for (int i = 0; i < 3; i++) {
        arr[i] = new Node();
        arr[i].value = i * 100;
    }
    // 字段读
    println(arr[1].value);          // 100
    // 方法调用
    println(arr[2].getValue());     // 200
    // 方法调用产生副作用
    arr[1].bump();
    println(arr[1].value);          // 101
    // 写后读
    arr[0].next = arr[1];
    println(arr[0].next.value);     // 101
    return 0;
}
